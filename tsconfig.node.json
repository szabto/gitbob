{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "eslint.config.js",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/git-core/**/*",
    "src/git-graph/**/*",
    "src/providers/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "tests/e2e/**"
  ]
}